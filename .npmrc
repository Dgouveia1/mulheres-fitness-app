# Garante uma única instância de React/Router/Supabase entre o pacote compartilhado
# e os 3 apps (evita "Invalid hook call" / contexto duplicado). Complementado por
# resolve.dedupe em cada vite.config.js.
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=react-router-dom
public-hoist-pattern[]=@supabase/supabase-js
