{
  "name": "mulheres-fitness-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "dev:agenda": "turbo run dev --filter=@emf/agenda",
    "dev:treino-admin": "turbo run dev --filter=@emf/treino-admin",
    "dev:treino": "turbo run dev --filter=@emf/treino",
    "build:agenda": "turbo run build --filter=@emf/agenda",
    "build:treino-admin": "turbo run build --filter=@emf/treino-admin",
    "build:treino": "turbo run build --filter=@emf/treino"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
